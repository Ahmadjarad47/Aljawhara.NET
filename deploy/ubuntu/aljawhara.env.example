# Install as /etc/aljawhara/aljawhara.env, owned by root with mode 600.
# systemd EnvironmentFile syntax; no 'export' prefix.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=aljawhara;Username=aljawhara;Password=REPLACE_ME;SSL Mode=Disable"
# Preserve existing production values when switching databases.
JwtSettings__SecretKey="REPLACE_WITH_EXISTING_PRODUCTION_KEY"
CheckoutSecurity__GuestTokenDerivationKey="REPLACE_WITH_EXISTING_PRODUCTION_KEY"
DatabaseBackup__Enabled=true
DatabaseBackup__Directory=/var/backups/aljawhara
# 00:00 UTC = 03:00 in Asia/Damascus.
DatabaseBackup__HourUtc=0
DatabaseBackup__RetentionDays=14
DatabaseBackup__TimeoutMinutes=60
DatabaseBackup__PgDumpPath=/usr/bin/pg_dump
DatabaseBackup__PgRestorePath=/usr/bin/pg_restore
# Keep your existing SMTP, Sadad, R2, JWT issuer/audience and other service settings.
