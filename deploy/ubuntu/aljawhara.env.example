# Install as /etc/aljawhara/aljawhara.env, owned by root with mode 600.
# systemd EnvironmentFile syntax; no 'export' prefix.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=aljawhara;Username=aljawhara;Password=REPLACE_ME;SSL Mode=Disable"
# Preserve existing production values when switching databases.
JwtSettings__SecretKey="REPLACE_WITH_EXISTING_PRODUCTION_KEY"
CheckoutSecurity__GuestTokenDerivationKey="REPLACE_WITH_EXISTING_PRODUCTION_KEY"
DatabaseBackup__Enabled=true
DatabaseBackup__Directory=/var/backups/aljawhara
# 00:00 UTC = 03:00 in Asia/Damascus.
DatabaseBackup__HourUtc=0
DatabaseBackup__RetentionCount=3
DatabaseBackup__TimeoutMinutes=60
DatabaseBackup__PgDumpPath=/usr/bin/pg_dump
DatabaseBackup__PgRestorePath=/usr/bin/pg_restore
Monitoring__Directory=/var/log/aljawhara
Monitoring__RetentionDays=3
Monitoring__MaxFiles=100
Monitoring__MaxFileBytes=10485760
Monitoring__RecentEventLimit=5000
Monitoring__HealthIntervalSeconds=30
Monitoring__SlowRequestMilliseconds=2000
# SMTP. Inject all four values to enable email delivery.
SmtpSettings__Host=
SmtpSettings__Username=
SmtpSettings__Password=
SmtpSettings__FromEmail=
# SmtpSettings__Port=465

# Telegram paid-order notifications. Keep the real bot token only in the
# root-owned /etc/aljawhara/aljawhara.env file (mode 600), never in Git.
Telegram__Enabled=false
Telegram__BotToken="REPLACE_WITH_A_NEW_BOT_TOKEN"
Telegram__ChatId="REPLACE_WITH_TARGET_CHAT_ID"
# Optional for a topic inside a forum-style supergroup:
# Telegram__MessageThreadId=123
Telegram__TimeZoneId="Asia/Kuwait"
Telegram__MaxAttempts=8
Telegram__ProtectContent=false
# WhatsApp/Gupshup is disabled. The application also enforces this in code.
Gupshup__Enabled=false
Gupshup_sandbox__Enabled=false
# Supply R2 credentials and bucket settings through the private environment file.
# R2_KEY=
# R2_SECRET=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_PUBLIC_DOMAIN=

# Keep your existing Sadad, JWT issuer/audience and other service settings.
# Sadad authentication (use real values from the same environment as Sadad__BaseUrl):
# Sadad__BaseUrl="https://apisandbox.sadadpay.net"
# Sadad__ClientKey="REPLACE_WITH_SADAD_CLIENT_KEY"
# Sadad__ClientSecret="REPLACE_WITH_SADAD_CLIENT_SECRET"
# Existing flat ClientKey / ClientSecret settings are also supported.
Sadad__MerchantVendorId="REPLACE_WITH_YOUR_VENDOR_ID"
# Temporary financial-only invoice diagnostics (disabled by default):
# Sadad__Diagnostics__EnableInvoiceLogging=true
# Keep paid transitions fail-closed until the deployed build passes its tests and
# this merchant's production GetById response is certified against the expected
# Capture/Success transaction fields. Change both values to true together only
# after that check. Discount and GetAll recovery remain separate certifications.
Sadad__Verification__ContractProfileCertified=false
Sadad__Verification__EnablePaidTransitions=false
Sadad__Verification__DiscountSemanticsCertified=false
Sadad__Verification__GetAllContractCertified=false
